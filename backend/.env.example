# JUSTIQ Backend Environment Variables

# Node & App Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# CORS Allowed Origins (comma-separated or single origin)
ALLOWED_ORIGINS=http://localhost:5173

# Database Connection (e.g., PostgreSQL / MongoDB)
DATABASE_URL=postgresql://postgres:password@localhost:5432/justiq_db

# Authentication / JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# AI Model Provider (e.g., Gemini API / OpenAI)
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-2.5-flash
